@model DangPhatFlex.Web.Areas.Admin.Models.NewsArticleFormViewModel

<section class="container py-4">
    <h1>Sửa bài viết</h1>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Slug" class="form-label"></label>
            <input asp-for="Slug" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Summary" class="form-label">Tóm tắt</label>
            <textarea asp-for="Summary" class="form-control" rows="2">@Model.Summary</textarea>
        </div>
        <div class="mb-3">
            <label asp-for="Content" class="form-label">Nội dung (mỗi đoạn cách nhau 1 dòng trống)</label>
            <textarea asp-for="Content" class="form-control" rows="14">@Model.Content</textarea>
        </div>
        <div class="mb-3">
            <label asp-for="CoverImage" class="form-label">Ảnh bìa (chọn để thay ảnh mới)</label>
            <input asp-for="CoverImage" type="file" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="CoverImageAlt" class="form-label">Alt text ảnh bìa</label>
            <input asp-for="CoverImageAlt" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="PublishedAt" class="form-label">Ngày đăng</label>
            <input asp-for="PublishedAt" type="date" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="MetaTitle" class="form-label"></label>
            <input asp-for="MetaTitle" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="MetaDescription" class="form-label"></label>
            <textarea asp-for="MetaDescription" class="form-control">@Model.MetaDescription</textarea>
        </div>
        <button type="submit" class="btn btn-brand">Lưu</button>
    </form>
</section>
