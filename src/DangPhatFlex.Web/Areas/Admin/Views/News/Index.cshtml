@model List<DangPhatFlex.Web.Models.NewsArticle>

<div class="admin-page-head">
    <h1>Tin tức</h1>
    <a class="btn btn-brand" asp-action="Create">
        @await Html.PartialAsync("_Icon", "plus")
        Thêm bài viết
    </a>
</div>

<div class="admin-card admin-card--flush">
    @if (!Model.Any())
    {
        <div class="admin-empty">Chưa có bài viết nào. Bấm “Thêm bài viết” để tạo mới.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Tiêu đề</th>
                        <th>Đường dẫn</th>
                        <th>Ngày đăng</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var n in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@n.Title</td>
                            <td><span class="admin-slug">@n.Slug</span></td>
                            <td>@n.PublishedAt.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="admin-table__actions">
                                    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@n.Id">
                                        @await Html.PartialAsync("_Icon", "edit")
                                        Sửa
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@n.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-outline-danger"
                                                onclick="return confirm('Xóa bài viết này?');">
                                            @await Html.PartialAsync("_Icon", "trash")
                                            Xóa
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
