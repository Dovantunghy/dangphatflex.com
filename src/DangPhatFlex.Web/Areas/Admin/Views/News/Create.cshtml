@model DangPhatFlex.Web.Areas.Admin.Models.NewsArticleFormViewModel

<div class="admin-page-head">
    <h1>Thêm bài viết</h1>
</div>

<div class="admin-card admin-form">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Slug" class="form-label">Slug (để trống để tự sinh)</label>
            <input asp-for="Slug" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Summary" class="form-label">Tóm tắt</label>
            <textarea asp-for="Summary" class="form-control" rows="2"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="Content" class="form-label">Nội dung (mỗi đoạn cách nhau 1 dòng trống)</label>
            <textarea asp-for="Content" class="form-control" rows="14"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="CoverImage" class="form-label">Ảnh bìa</label>
            <input asp-for="CoverImage" type="file" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="CoverImageAlt" class="form-label">Alt text ảnh bìa</label>
            <input asp-for="CoverImageAlt" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="PublishedAt" class="form-label">Ngày đăng</label>
            <input asp-for="PublishedAt" type="date" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="MetaTitle" class="form-label"></label>
            <input asp-for="MetaTitle" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="MetaDescription" class="form-label"></label>
            <textarea asp-for="MetaDescription" class="form-control"></textarea>
        </div>
        <button type="submit" class="btn btn-brand">Lưu</button>
    </form>
</div>
