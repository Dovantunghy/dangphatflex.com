@model DangPhatFlex.Web.Models.Product
@using System.Text.Json
@{
    ViewData["MetaTitle"] = Model.MetaTitle ?? Model.Name;
    ViewData["MetaDescription"] = Model.MetaDescription ?? Model.Description;

    var jsonLd = JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Product",
        ["name"] = Model.Name,
        ["description"] = Model.Description,
        ["brand"] = new Dictionary<string, object?>
        {
            ["@type"] = "Brand",
            ["name"] = "Đăng Phát Flex"
        }
    });

    var standards = (Model.Standards ?? string.Empty)
        .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
}

@*
    Rendered via Html.Raw rather than plain Razor markup: a literal <script type="application/ld+json">
    tag has its attributes and text content run through Razor's default HtmlEncoder (which HTML-entity-
    encodes both non-ASCII characters and the '+' in "ld+json"), corrupting both the mime type attribute
    and the JSON payload for real crawlers. Building the JSON with System.Text.Json and emitting it raw
    avoids that.
*@
@Html.Raw($"<script type=\"application/ld+json\">{jsonLd}</script>")

<section class="section pt-4">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Sản phẩm</a></li>
                <li class="breadcrumb-item active">@Model.Name</li>
            </ol>
        </nav>

        <div class="row g-5">
            <div class="col-lg-5">
                @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                {
                    <img src="@Model.MainImageUrl" alt="@(Model.MainImageAlt ?? Model.Name)" class="img-fluid rounded" style="border-radius: var(--dpf-radius-md);" />
                }
                else
                {
                    <div class="product-card__media" style="border-radius: var(--dpf-radius-md); aspect-ratio: 4/3;">
                        @await Html.PartialAsync("_Icon", "pipe")
                    </div>
                }
                @if (standards.Length > 0)
                {
                    <div class="mt-3">
                        @foreach (var std in standards)
                        {
                            <span class="badge-standard">@std</span>
                        }
                    </div>
                }
            </div>
            <div class="col-lg-7">
                <h1>@Model.Name</h1>
                <p class="lead">@Model.Description</p>

                @if (!string.IsNullOrEmpty(Model.DatasheetPdfUrl))
                {
                    <a class="btn btn-brand mb-2" href="@Model.DatasheetPdfUrl" target="_blank" rel="noopener">
                        @await Html.PartialAsync("_Icon", "download")
                        Tải Datasheet PDF
                    </a>
                }
                <a class="btn btn-outline-primary mb-2 ms-0 ms-sm-2" asp-area="Public" asp-controller="Contact" asp-action="Index">
                    Yêu cầu báo giá
                </a>

                <h2 class="h4 mt-4">Thông số kỹ thuật</h2>
                <table class="table spec-table">
                    <tbody>
                        <tr><th>Đường kính ống</th><td>ID: @Model.InnerDiameter / OD: @Model.OuterDiameter</td></tr>
                        <tr><th>Loại ống</th><td>@Model.HoseType</td></tr>
                        <tr><th>Nhiệt độ hoạt động tối đa</th><td>@Model.MaxTemperature</td></tr>
                        <tr><th>Áp suất hoạt động tối đa</th><td>@Model.MaxPressure</td></tr>
                        <tr><th>Bán kính uốn cong nhỏ nhất</th><td>@Model.MinBendRadius</td></tr>
                        <tr><th>Tiêu chuẩn</th><td>@Model.Standards</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-5">
            <h2 class="h4">Bảng mã sản phẩm</h2>
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Mã sản phẩm</th>
                            <th>Kết nối (Inlet x Outlet)</th>
                            <th>Chiều dài lắp đặt (mm)</th>
                            <th>Số lần uốn 90° tối đa</th>
                            <th>Bán kính uốn cong tối thiểu (in)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.Variants)
                        {
                            <tr>
                                <td><code>@v.ProductCode</code></td>
                                <td>@v.InletOutlet</td>
                                <td>@v.InstallLengthMm</td>
                                <td>@v.MaxBends90</td>
                                <td>@v.MinBendRadiusIn</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.Accessories.Any())
        {
            <div class="mt-5">
                <h2 class="h4">Phụ kiện đi kèm</h2>
                <div class="row g-3">
                    @foreach (var a in Model.Accessories)
                    {
                        <div class="col-6 col-md-3">
                            <div class="value-card text-center py-3">
                                @if (!string.IsNullOrEmpty(a.ImageUrl))
                                {
                                    <img src="@a.ImageUrl" alt="@(a.ImageAlt ?? a.Name)" class="mx-auto mb-2" style="width:100%;aspect-ratio:1;object-fit:cover;border-radius:var(--dpf-radius-sm);" />
                                }
                                else
                                {
                                    <span class="icon-box icon-box--gold mx-auto mb-2">@await Html.PartialAsync("_Icon", "check-circle")</span>
                                }
                                <div class="fw-semibold small">@a.Name</div>
                                <div class="text-body-secondary small">SL: @a.DefaultQuantity</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>
