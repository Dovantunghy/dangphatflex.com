@using DangPhatFlex.Web.Models
@using System.Text.Json
@{
    var company = ViewData["CompanyInfo"] as CompanyInfo;
    var featured = ViewData["FeaturedProducts"] as List<Product> ?? new();
    ViewData["MetaTitle"] = "Ống mềm nối đầu phun sprinkler - Dây mềm nối đầu phun | Đăng Phát Flex";
    ViewData["MetaDescription"] = "Đăng Phát Flex chuyên sản xuất, phân phối ống mềm nối đầu phun sprinkler, " +
        "dây mềm nối đầu phun sprinkler đạt chuẩn UL/FM/TCVN. Giao hàng nhanh, giá cạnh tranh toàn quốc.";

    var jsonLd = JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Organization",
        ["name"] = company?.LegalName,
        ["alternateName"] = company?.BrandName,
        ["email"] = company?.Email,
        ["telephone"] = company?.Hotline,
        ["address"] = company?.Address
    });
}

@*
    Rendered via Html.Raw rather than plain Razor markup: a literal <script type="application/ld+json">
    tag has its attributes and text content run through Razor's default HtmlEncoder (which HTML-entity-
    encodes both non-ASCII characters and the '+' in "ld+json"), corrupting both the mime type attribute
    and the JSON payload for real crawlers. Building the JSON with System.Text.Json and emitting it raw
    avoids that.
*@
@Html.Raw($"<script type=\"application/ld+json\">{jsonLd}</script>")

<section class="hero hero--home">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 hero-content">
                <span class="hero-badge">
                    @await Html.PartialAsync("_Icon", "shield-check")
                    Đạt chuẩn UL · FM · TCVN
                </span>
                <h1>Ống mềm nối đầu phun sprinkler @company?.BrandName</h1>
                <p class="lead">@company?.Tagline — chuyên sản xuất, nhập khẩu và phân phối ống mềm nối đầu phun sprinkler cho hệ thống chữa cháy tự động, HVAC và cấp thoát nước công nghiệp.</p>
                <div class="hero-cta">
                    <a class="btn btn-brand btn-lg" asp-controller="Contact" asp-action="Index">
                        Liên hệ tư vấn
                        @await Html.PartialAsync("_Icon", "arrow-right")
                    </a>
                    <a class="btn btn-hero-ghost btn-lg" asp-controller="Products" asp-action="Index">
                        Xem sản phẩm
                    </a>
                </div>
                <div class="hero-trust">
                    <span class="trust-item">@await Html.PartialAsync("_Icon", "truck") Giao hàng nhanh toàn quốc</span>
                    <span class="trust-item">@await Html.PartialAsync("_Icon", "award") Tiêu chuẩn quốc tế</span>
                    <span class="trust-item">@await Html.PartialAsync("_Icon", "tag") Giá cạnh tranh nhất</span>
                </div>
            </div>
            <div class="col-lg-6 hero-media-col">
                <div class="hero-media">
                    <img src="~/images/products/product-dp25-lineup.jpg" alt="Ống mềm nối đầu phun sprinkler DP25 Đăng Phát Flex - dây mềm nối đầu phun sprinkler inox" />
                    <span class="hero-media__chip">
                        @await Html.PartialAsync("_Icon", "shield-check")
                        UL · FM · TCVN
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="trust-bar">
    <div class="container">
        <div class="trust-bar__card">
            <div class="trust-bar__item">
                <span class="icon-box">@await Html.PartialAsync("_Icon", "shield-check")</span>
                <div>
                    <div class="trust-bar__title">UL Listed</div>
                    <div class="trust-bar__sub">Chứng nhận quốc tế</div>
                </div>
            </div>
            <div class="trust-bar__item">
                <span class="icon-box">@await Html.PartialAsync("_Icon", "shield-check")</span>
                <div>
                    <div class="trust-bar__title">FM Approved</div>
                    <div class="trust-bar__sub">Chuẩn bảo hiểm tài sản</div>
                </div>
            </div>
            <div class="trust-bar__item">
                <span class="icon-box icon-box--gold">@await Html.PartialAsync("_Icon", "check-circle")</span>
                <div>
                    <div class="trust-bar__title">TCVN</div>
                    <div class="trust-bar__sub">Nghiệm thu PCCC</div>
                </div>
            </div>
            <div class="trust-bar__item">
                <span class="icon-box">@await Html.PartialAsync("_Icon", "clock")</span>
                <div>
                    <div class="trust-bar__title">107°C · 200psi</div>
                    <div class="trust-bar__sub">Thông số vận hành</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section pb-0">
    <div class="container">
        <div class="mx-auto text-center" style="max-width: 780px;">
            <h2 class="section-title">Ống mềm nối đầu phun sprinkler là gì?</h2>
            <p class="section-subtitle mx-auto">
                <strong>Ống mềm nối đầu phun</strong> (hay còn gọi là <strong>dây mềm nối đầu phun sprinkler</strong>)
                là đoạn ống inox dạng gân xoắn, dùng để kết nối linh hoạt giữa đường ống chính và đầu phun trong hệ
                thống chữa cháy tự động. Đăng Phát Flex là đơn vị sản xuất và phân phối
                <strong>ống mềm nối đầu phun sprinkler</strong> đạt chuẩn UL, FM, TCVN với đầy đủ chiều dài và cỡ kết
                nối, sẵn hàng giao nhanh cho mọi công trình.
                <a asp-controller="News" asp-action="Index">Xem thêm kiến thức về ống mềm nối đầu phun</a>.
            </p>
        </div>
    </div>
</section>

<section class="core-values section">
    <div class="container">
        <div class="text-center mx-auto mb-5" style="max-width:640px;">
            <span class="section-eyebrow">Cam kết của chúng tôi</span>
            <h2 class="section-title">Vì sao khách hàng tin chọn Đăng Phát Flex</h2>
            <p class="section-subtitle mx-auto">Ba giá trị cốt lõi xuyên suốt mọi sản phẩm và dịch vụ chúng tôi cung cấp.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="value-card">
                    <span class="icon-box">@await Html.PartialAsync("_Icon", "truck")</span>
                    <h3>Nhanh nhất</h3>
                    <p>@company?.CoreValueFast</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="value-card">
                    <span class="icon-box icon-box--gold">@await Html.PartialAsync("_Icon", "award")</span>
                    <h3>Tốt nhất</h3>
                    <p>@company?.CoreValueBest</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="value-card">
                    <span class="icon-box">@await Html.PartialAsync("_Icon", "tag")</span>
                    <h3>Giá cạnh tranh nhất</h3>
                    <p>@company?.CoreValueCompetitivePrice</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="featured-products section bg-light-section">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-5 gap-3">
            <div>
                <span class="section-eyebrow">Sản phẩm</span>
                <h2 class="section-title mb-0">Sản phẩm nổi bật</h2>
            </div>
            <a class="btn btn-outline-primary" asp-controller="Products" asp-action="Index">
                Xem tất cả sản phẩm
                @await Html.PartialAsync("_Icon", "arrow-right")
            </a>
        </div>
        <div class="row g-4 justify-content-center">
            @foreach (var product in featured)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="product-card">
                        <div class="product-card__media">
                            @if (!string.IsNullOrEmpty(product.MainImageUrl))
                            {
                                <img src="@product.MainImageUrl" alt="@(product.MainImageAlt ?? product.Name)" style="width:100%;height:100%;object-fit:cover;" />
                            }
                            else
                            {
                                @await Html.PartialAsync("_Icon", "pipe")
                            }
                        </div>
                        <div class="product-card__body">
                            @if (!string.IsNullOrEmpty(product.Standards))
                            {
                                <div class="mb-2">
                                    @foreach (var std in product.Standards.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="badge-standard">@std</span>
                                    }
                                </div>
                            }
                            <h3 class="card-title">@product.Name</h3>
                            <p class="card-text">@product.Description</p>
                            <a class="btn btn-outline-primary"
                               asp-controller="Products" asp-action="Detail"
                               asp-route-categorySlug="@product.ProductCategory?.Slug"
                               asp-route-productSlug="@product.Slug">
                                Xem chi tiết
                                @await Html.PartialAsync("_Icon", "arrow-right")
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="cta-banner">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <h2 class="mb-2">Cần tư vấn giải pháp khớp nối mềm inox?</h2>
                    <p class="mb-0">Đội ngũ kỹ thuật của Đăng Phát Flex sẵn sàng hỗ trợ chọn đúng sản phẩm cho công trình của bạn — nhanh chóng, chính xác, đúng tiêu chuẩn.</p>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a class="btn btn-brand btn-lg" asp-controller="Contact" asp-action="Index">Liên hệ ngay</a>
                </div>
            </div>
        </div>
    </div>
</section>
