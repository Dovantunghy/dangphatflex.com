@model string
@{
    // Minimal inline SVG icon set (stroke-based, 24x24 viewBox, 1.75px stroke) so the site
    // has no external icon-font/CDN dependency, consistent with the vendored-library approach
    // already used for Bootstrap/jQuery.
    //
    // Every <svg> below carries class="dpf-icon" — SVG elements with no width/height attribute
    // default to the CSS-spec fallback size of 300x150px, so without an explicit sizing class
    // every icon renders enormous and breaks its container's layout. site.css's global
    // `.dpf-icon` rule (and more specific overrides like `.icon-box svg`) are what actually
    // constrain the size; never add an <svg> here without this class.
}
@switch (Model)
{
    case "truck":
        <svg class="dpf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.75"/><circle cx="17.5" cy="18" r="1.75"/></svg>
        break;
    case "award":
        <svg class="dpf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="5"/><path d="M8.5 12.5 7 21l5-2.5L17 21l-1.5-8.5"/></svg>
        break;
    case "tag":
        <svg class="dpf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12 12.5 19.5a2 2 0 0 1-2.8 0L4 13.8a2 2 0 0 1 0-2.8L11.5 3.5H18a2 2 0 0 1 2 2z"/><circle cx="15" cy="8" r="1.25"/></svg>
        break;
    case "shield-check":
        <svg class="dpf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 5.5v6C4.5 16.5 7.5 20 12 21c4.5-1 7.5-4.5 7.5-9.5v-6z"/><path d="m9 12 2 2 4-4.5"/></svg>
        break;
    case "phone":
        <svg class="dpf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3h3l1.5 4.5-2 1.5a11 11 0 0 0 5 5l1.5-2L20 13.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3z"/></svg>
        break;
    case "mail":
        <svg class="dpf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m4.5 7 7.5 6 7.5-6"/></svg>
        break;
    case "map-pin":
        <svg class="dpf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.4 7-11.5A7 7 0 0 0 5 9.5C5 14.6 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.25"/></svg>
        break;
    case "pipe":
        <svg class="dpf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h9a4 4 0 0 1 4 4v6"/><path d="M4 6v6"/><path d="M14 16h6"/><circle cx="4" cy="9" r="2.5"/><circle cx="17" cy="19" r="2.5"/></svg>
        break;
    case "check-circle":
        <svg class="dpf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="m8.5 12 2.3 2.3L15.5 9.5"/></svg>
        break;
    case "download":
        <svg class="dpf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"/><path d="m7.5 11 4.5 4.5 4.5-4.5"/><path d="M5 19.5h14"/></svg>
        break;
    case "arrow-right":
        <svg class="dpf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12h15"/><path d="m13 5.5 6.5 6.5-6.5 6.5"/></svg>
        break;
    case "boxes":
        <svg class="dpf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 7.5v9L12 21l8-4.5v-9z"/><path d="M4 7.5 12 12l8-4.5"/><path d="M12 12v9"/></svg>
        break;
    case "clock":
        <svg class="dpf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3.5 2"/></svg>
        break;
    default:
        break;
}
