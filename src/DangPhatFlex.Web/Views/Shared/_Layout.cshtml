@using DangPhatFlex.Web.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext LayoutDbContext
@{
    var footerCompany = await LayoutDbContext.CompanyInfos.AsNoTracking().FirstOrDefaultAsync();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @await Html.PartialAsync("_SeoMeta")
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg site-navbar">
            <div class="container">
                <a class="navbar-brand" asp-area="Public" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Đăng Phát Flex - Giải pháp khớp nối mềm inox" height="52" />
                </a>
                <a class="navbar-hotline d-none d-lg-flex ms-auto me-4" href="tel:@(footerCompany?.Hotline?.Replace(".", "").Replace(" ", ""))">
                    @await Html.PartialAsync("_Icon", "phone")
                    <span>@footerCompany?.Hotline</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu điều hướng">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" asp-area="Public" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="Public" asp-controller="About" asp-action="Index">Giới thiệu</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="Public" asp-controller="Products" asp-action="Index">Sản phẩm</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="Public" asp-controller="News" asp-action="Index">Tin tức</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="Public" asp-controller="Contact" asp-action="Index">Liên hệ</a></li>
                        <li class="nav-item d-lg-none">
                            <a class="nav-link navbar-hotline" href="tel:@(footerCompany?.Hotline?.Replace(".", "").Replace(" ", ""))">
                                @await Html.PartialAsync("_Icon", "phone")
                                <span>@footerCompany?.Hotline</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4">
                    <div class="footer-brand">
                        <img src="~/images/logo.png" alt="" height="32" />
                        <span>Đăng Phát Flex</span>
                    </div>
                    <p>@footerCompany?.Tagline</p>
                    <p class="small">@footerCompany?.LegalName</p>
                </div>
                <div class="col-6 col-lg-2">
                    <h5>Liên kết</h5>
                    <ul>
                        <li><a asp-area="Public" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li><a asp-area="Public" asp-controller="About" asp-action="Index">Giới thiệu</a></li>
                        <li><a asp-area="Public" asp-controller="Products" asp-action="Index">Sản phẩm</a></li>
                        <li><a asp-area="Public" asp-controller="News" asp-action="Index">Tin tức</a></li>
                        <li><a asp-area="Public" asp-controller="Contact" asp-action="Index">Liên hệ</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h5>Tiêu chuẩn</h5>
                    <ul>
                        <li>UL Listed</li>
                        <li>FM Approved</li>
                        <li>TCVN</li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h5>Liên hệ</h5>
                    <div class="footer-contact-row">
                        @await Html.PartialAsync("_Icon", "map-pin")
                        <span>@footerCompany?.Address</span>
                    </div>
                    <div class="footer-contact-row">
                        @await Html.PartialAsync("_Icon", "phone")
                        <a href="tel:@(footerCompany?.Hotline?.Replace(".", "").Replace(" ", ""))">@footerCompany?.Hotline</a>
                    </div>
                    <div class="footer-contact-row">
                        @await Html.PartialAsync("_Icon", "mail")
                        <a href="mailto:@footerCompany?.Email">@footerCompany?.Email</a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                &copy; @DateTime.Now.Year @footerCompany?.LegalName - Đăng Phát Flex. Đã đăng ký bản quyền.
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
