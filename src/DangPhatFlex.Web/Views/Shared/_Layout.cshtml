@using DangPhatFlex.Web.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext LayoutDbContext
@{
    var footerCompany = await LayoutDbContext.CompanyInfos.AsNoTracking().FirstOrDefaultAsync();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    string NavClass(string controllerName) =>
        string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase)
            ? "nav-link active"
            : "nav-link";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @await Html.PartialAsync("_SeoMeta")
    <link rel="icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="topbar">
            <div class="container topbar-inner">
                <a class="topbar-item" href="mailto:@footerCompany?.Email">
                    @await Html.PartialAsync("_Icon", "mail")
                    <span>@footerCompany?.Email</span>
                </a>
                <span class="topbar-item d-none d-md-flex">
                    @await Html.PartialAsync("_Icon", "clock")
                    <span>Giờ làm việc: T2 - T7, 8:00 - 17:30</span>
                </span>
                <span class="topbar-item topbar-item--address d-none d-lg-flex ms-auto">
                    @await Html.PartialAsync("_Icon", "map-pin")
                    <span>@footerCompany?.Address</span>
                </span>
            </div>
        </div>
        <nav class="navbar navbar-expand-lg site-navbar">
            <div class="container">
                <a class="navbar-brand" asp-area="Public" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Đăng Phát Flex - Giải pháp khớp nối mềm inox" height="52" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu điều hướng">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-lg-auto">
                        <li class="nav-item"><a class="@NavClass("Home")" asp-area="Public" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item"><a class="@NavClass("About")" asp-area="Public" asp-controller="About" asp-action="Index">Giới thiệu</a></li>
                        <li class="nav-item"><a class="@NavClass("Products")" asp-area="Public" asp-controller="Products" asp-action="Index">Sản phẩm</a></li>
                        <li class="nav-item"><a class="@NavClass("News")" asp-area="Public" asp-controller="News" asp-action="Index">Tin tức</a></li>
                        <li class="nav-item"><a class="@NavClass("Contact")" asp-area="Public" asp-controller="Contact" asp-action="Index">Liên hệ</a></li>
                    </ul>
                    <div class="navbar-cta">
                        <a class="navbar-hotline" href="tel:@(footerCompany?.Hotline?.Replace(".", "").Replace(" ", ""))">
                            @await Html.PartialAsync("_Icon", "phone")
                            <span>@footerCompany?.Hotline</span>
                        </a>
                        <a class="btn btn-brand" asp-area="Public" asp-controller="Contact" asp-action="Index">Yêu cầu báo giá</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4">
                    <div class="footer-brand">
                        <img src="~/images/logo.png" alt="" height="32" />
                        <span>Đăng Phát Flex</span>
                    </div>
                    <p>@footerCompany?.Tagline</p>
                    <p class="small">@footerCompany?.LegalName</p>
                </div>
                <div class="col-6 col-lg-2">
                    <h5>Liên kết</h5>
                    <ul>
                        <li><a asp-area="Public" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li><a asp-area="Public" asp-controller="About" asp-action="Index">Giới thiệu</a></li>
                        <li><a asp-area="Public" asp-controller="Products" asp-action="Index">Sản phẩm</a></li>
                        <li><a asp-area="Public" asp-controller="News" asp-action="Index">Tin tức</a></li>
                        <li><a asp-area="Public" asp-controller="Contact" asp-action="Index">Liên hệ</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h5>Tiêu chuẩn sản xuất</h5>
                    <ul>
                        <li>Tiêu chuẩn UL</li>
                        <li>Tiêu chuẩn FM</li>
                        <li>TCVN</li>
                        <li>ISO 9001</li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h5>Liên hệ</h5>
                    <div class="footer-contact-row">
                        @await Html.PartialAsync("_Icon", "map-pin")
                        <span>@footerCompany?.Address</span>
                    </div>
                    <div class="footer-contact-row">
                        @await Html.PartialAsync("_Icon", "boxes")
                        <span>Nhà máy: Tổ 26, Phường Việt Hưng, TP. Hà Nội</span>
                    </div>
                    <div class="footer-contact-row">
                        @await Html.PartialAsync("_Icon", "phone")
                        <a href="tel:@(footerCompany?.Hotline?.Replace(".", "").Replace(" ", ""))">@footerCompany?.Hotline</a>
                    </div>
                    <div class="footer-contact-row">
                        @await Html.PartialAsync("_Icon", "mail")
                        <a href="mailto:@footerCompany?.Email">@footerCompany?.Email</a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                &copy; @DateTime.Now.Year @footerCompany?.LegalName - Đăng Phát Flex. MST: 0109665394. Đã đăng ký bản quyền.
            </div>
        </div>
    </footer>

    @* Nút chat Zalo nổi — kết nối thẳng tới Zalo tư vấn (Ms Ngọc). *@
    <div class="zalo-widget">
        <div class="zalo-widget__pop" id="zaloPop" hidden>
            <button type="button" class="zalo-widget__x" id="zaloClose" aria-label="Đóng">&times;</button>
            <p class="zalo-widget__text">
                <strong>👋 Cần tư vấn ống mềm sprinkler?</strong>
                Chat Zalo với Ms Ngọc để được báo giá nhanh nhất.
            </p>
            <a class="zalo-widget__cta" href="https://zalo.me/0336046668" target="_blank" rel="noopener">Chat ngay</a>
        </div>
        <a class="zalo-fab" href="https://zalo.me/0336046668" target="_blank" rel="noopener"
           aria-label="Chat Zalo tư vấn với Ms Ngọc, số 0336046668">
            <span class="zalo-fab__pulse" aria-hidden="true"></span>
            <span class="zalo-fab__icon" aria-hidden="true">
                <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                    <path d="M24 9C14.6 9 7 15.2 7 22.9c0 4.4 2.4 8.3 6.2 10.9-.2 1.7-.9 3.9-2.4 5.6-.5.6.1 1.4.8 1.2 3.1-.5 5.8-1.8 7.5-3 1.8.5 3.8.8 5.9.8 9.4 0 17-6.3 17-14S33.4 9 24 9Z" fill="#fff"/>
                    <text x="24" y="27.5" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="12.5" font-weight="700" fill="#0068FF">Zalo</text>
                </svg>
            </span>
            <span class="zalo-fab__label">Chat Zalo tư vấn</span>
        </a>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
